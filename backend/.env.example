# Application Environment
NODE_ENV=development
PORT=3000

# CORS Configuration
# In local development: http://localhost:4200
# In production on Vercel: https://your-frontend-domain.vercel.app (or comma-separated URLs)
FRONTEND_URL=http://localhost:4200

# Database Configuration (PostgreSQL)
# Local Docker development: postgresql://postgres:postgres@localhost:5432/financial_db?schema=public
# Production (e.g. Neon): postgresql://<user>:<password>@<neon-hostname>/financial_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_db?schema=public
