# Application Environment
NODE_ENV=development
PORT=3000

# CORS Configuration
# In local development: http://localhost:4200
# In production on Vercel: https://your-frontend-domain.vercel.app (or comma-separated URLs)
FRONTEND_URL=http://localhost:4200

# Database Configuration (PostgreSQL)
# DATABASE_URL: Conexao com pooling (PgBouncer) usada em runtime pelo NestJS / Prisma Client
# Exemplo Neon: postgresql://<user>:<password>@<host-pooler>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_db?schema=public

# DIRECT_URL: Conexao direta sem pooling usada pelo Prisma Migrate para migrations e DDL
# Exemplo Neon: postgresql://<user>:<password>@<host-direct>.neon.tech/<dbname>?sslmode=require
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/financial_db?schema=public
